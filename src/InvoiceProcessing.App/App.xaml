<Application x:Class="InvoiceProcessing.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:InvoiceProcessing.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 Fluent look, built into WPF (.NET 9+) -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusVisualConverter x:Key="StatusVisual" />
            <converters:LogStatusTextConverter x:Key="LogStatusText" />
            <converters:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <converters:LocalTimeConverter x:Key="LocalTime" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <SolidColorBrush x:Key="PageBackground" Color="#F3F4F6" />
            <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorder" Color="#E3E5E8" />
            <SolidColorBrush x:Key="MutedText" Color="#5F6368" />
            <SolidColorBrush x:Key="Brand" Color="#0F5C8C" />
            <SolidColorBrush x:Key="BrandSoft" Color="#E8F1F8" />

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0" />
            </Style>

            <Style x:Key="RightCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,10,0" />
            </Style>

            <Style x:Key="WrapCell" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,3" />
            </Style>

            <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="HorizontalGridLinesBrush" Value="#EDEEF0" />
            </Style>

            <!-- Round status icon; DataContext = ImportState or log status code -->
            <DataTemplate x:Key="StatusBadge">
                <Border Width="30" Height="30" CornerRadius="15"
                        Background="{Binding Converter={StaticResource StatusVisual}, ConverterParameter=Background}">
                    <TextBlock Style="{StaticResource Icon}" FontSize="14"
                               Text="{Binding Converter={StaticResource StatusVisual}, ConverterParameter=Glyph}"
                               Foreground="{Binding Converter={StaticResource StatusVisual}, ConverterParameter=Foreground}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
